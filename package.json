{
  "name": "owoify-editor",
  "displayName": "owoify editor",
  "description": "",
  "version": "99.0.0",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": [
      {
        "title": "",
        "properties": {
          "owoify-editor.onlyVisibleRanges": {
            "type": "boolean",
            "default": false,
            "description": "Only apply OwO decorations to the visible portion of the editor."
          },
          "owoify-editor.onlyVisibleRangesThreshold": {
            "type": "number",
            "default": 0,
            "description": "Use visible-ranges-only mode when the document exceeds this size (0 = disabled). Unit is controlled by onlyVisibleRangesThresholdUnit."
          },
          "owoify-editor.onlyVisibleRangesThresholdUnit": {
            "type": "string",
            "enum": [
              "lines",
              "characters"
            ],
            "default": "lines",
            "description": "Whether the threshold is measured in lines or characters."
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "publisher": "rssaromeo",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
